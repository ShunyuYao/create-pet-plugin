{
  "name": "create-pet-plugin",
  "version": "1.0.0-rc.3",
  "description": "生成桌宠（吐梨邦）插件骨架：tool/panel/dashboard-card 与实验性纯数据 theme 样板，对应 apiVersion 1",
  "bin": {
    "create-pet-plugin": "index.js"
  },
  "files": [
    "index.js",
    "templates",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShunyuYao/create-pet-plugin.git"
  },
  "dependencies": {
    "@pet/plugin-types": "github:ShunyuYao/pet-plugin-types"
  },
  "scripts": {
    "test": "npm run test:generate",
    "test:generate": "node test/generate-test.js",
    "test:delivery": "node test/generate-test.js --require-host"
  },
  "petSdk": {
    "apiVersion": 1,
    "note": "tool/panel/dashboard-card 样板只调用 A 档能力；theme 是未发布的实验性纯数据格式，不增加 SDK 方法。所有样板声明 apiVersion 1，不代表旧宿主支持新增能力。"
  }
}
